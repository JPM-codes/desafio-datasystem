<%- include('../includes/header') %>
    <%- include('../includes/navbar') %>
        <%- include('../includes/topbar') %>

            <section class="page">
                <div class="page-head">
                    <div>
                        <div class="page-eyebrow">Fidelidade</div>
                        <h1 class="page-title">Histórico de movimentações</h1>
                        <div class="page-subtitle">Acompanhe todas as movimentações de pontos</div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <!-- Vendas / Acúmulo -->
                        <span
                            class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-2 d-inline-flex align-items-center gap-1 fs-6 fw-semibold">
                            <i class="bi bi-arrow-up-right-circle-fill me-1"></i>
                            <span>
                                <%= (typeof totalCompras !=='undefined' ) ? totalCompras : 0 %>
                            </span>
                            <span class="fw-normal text-muted ms-1" style="font-size: 0.85em;">vendas</span>
                        </span>

                        <!-- Resgates -->
                        <span
                            class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 d-inline-flex align-items-center gap-1 fs-6 fw-semibold">
                            <i class="bi bi-arrow-down-right-circle-fill me-1"></i>
                            <span>
                                <%= (typeof totalResgates !=='undefined' ) ? totalResgates : 0 %>
                            </span>
                            <span class="fw-normal text-muted ms-1" style="font-size: 0.85em;">resgates</span>
                        </span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <!-- Card Acúmulos -->
                    <div class="col-xl-3 col-6">
                        <div class="card stat-mini border-0 shadow-sm rounded-4 p-3 bg-white">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="label text-muted small fw-medium">Acúmulos</span>
                                <div class="rounded-circle bg-success-subtle p-2 d-flex align-items-center justify-content-center"
                                    style="width: 36px; height: 36px;">
                                    <i class="bi bi-arrow-up-circle-fill fs-5 text-success"></i>
                                </div>
                            </div>
                            <div class="value fs-3 fw-bold text-success">
                                <%= movimentacoes.filter(m=> m.tipo === 'acumulo').reduce((s, m) => s + m.pontos,
                                    0).toLocaleString('pt-BR') %>
                            </div>
                        </div>
                    </div>

                    <!-- Card Resgates -->
                    <div class="col-xl-3 col-6">
                        <div class="card stat-mini border-0 shadow-sm rounded-4 p-3 bg-white">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="label text-muted small fw-medium">Resgates</span>
                                <div class="rounded-circle bg-danger-subtle p-2 d-flex align-items-center justify-content-center"
                                    style="width: 36px; height: 36px;">
                                    <i class="bi bi-arrow-down-circle-fill fs-5 text-danger"></i>
                                </div>
                            </div>
                            <div class="value fs-3 fw-bold text-danger">
                                <%= movimentacoes.filter(m=> m.tipo === 'resgate').reduce((s, m) => s +
                                    Math.abs(m.pontos), 0).toLocaleString('pt-BR') %>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card section-card">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h6 class="card-title mb-0"><i class="bi bi-clock-history text-primary"></i>Movimentações</h6>
                        <span class="badge-level bronze mb-0 d-inline-flex align-items-center" id="contagem">
                            <%= movimentacoes.length %> movimentações
                        </span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-3"><select class="form-select" id="filtro-tipo">
                                <option value="">Todos os tipos</option>
                                <option value="acumulo">Acúmulo</option>
                                <option value="resgate">Resgate</option>
                            </select></div>
                        <div class="col-md-3"><input type="date" class="form-control" id="filtro-inicio"></div>
                        <div class="col-md-3"><input type="date" class="form-control" id="filtro-fim"></div>
                        <div class="col-md-3"><button class="btn btn-outline-primary w-100" id="btn-limpar">Limpar
                                filtros</button></div>
                    </div>

                    <div class="table-responsive">
                        <table class="table" id="tab-movimentacoes">
                            <thead>
                                <tr>
                                    <th>Data</th>
                                    <th>Tipo</th>
                                    <th>Pontos</th>
                                    <th>Cliente</th>
                                    <th>Referência</th>
                                    <th>Expiração</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% movimentacoes.forEach(function (mov) { %>
                                    <tr data-tipo="<%= mov.tipo %>" data-data="<%= mov.data %>">
                                        <td class="text-nowrap">
                                            <%= mov.data %>
                                        </td>
                                        <td>
                                            <span class="badge-tipo <%= mov.tipo %>">
                                                <%= mov.tipo.toUpperCase() %>
                                            </span>
                                        </td>
                                        <td class="fw-bold <%= mov.pontos > 0 ? 'text-success' : 'text-danger' %>">
                                            <%= mov.pontos> 0 ? '+' : '' %><%= mov.pontos.toLocaleString('pt-BR') %>
                                        </td>
                                        <td>
                                            <%= mov.cliente %>
                                        </td>
                                        <td>
                                            <%= mov.referencia %>
                                        </td>
                                        <td class="text-nowrap">
                                            <%= mov.expiracao %>
                                        </td>
                                    </tr>
                                    <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <script>
                const inpInicio = document.getElementById('filtro-inicio');
                const inpFim = document.getElementById('filtro-fim');
                const selTipo = document.getElementById('filtro-tipo');
                const contagem = document.getElementById('contagem');
                const linhas = Array.prototype.slice.call(document.querySelectorAll('#tab-movimentacoes tbody tr'));
                const totalMovimentacoes = linhas.length;

                function pad(n) { return String(n).padStart(2, '0'); }

                function paraIso(ddmm) {
                    const p = ddmm.split('/');
                    if (p.length !== 3) return '';
                    return p[2] + '-' + pad(p[1]) + '-' + pad(p[0]);
                }

                function filtrar() {
                    const t = selTipo.value;
                    const a = paraIso(inpInicio.value ? inpInicio.value.split('-').reverse().join('/') : '');
                    const b = paraIso(inpFim.value ? inpFim.value.split('-').reverse().join('/') : '');
                    let visiveis = 0;
                    linhas.forEach(function (linha) {
                        const data = paraIso(linha.dataset.data);
                        const okTipo = !t || linha.dataset.tipo === t;
                        const okInicio = !a || data >= a;
                        const okFim = !b || data <= b;
                        const ok = okTipo && okInicio && okFim;
                        linha.style.display = ok ? '' : 'none';
                        if (ok) visiveis++;
                    });
                    contagem.textContent = visiveis + ' de ' + totalMovimentacoes + ' movimentações';
                }

                selTipo.addEventListener('change', filtrar);
                inpInicio.addEventListener('change', filtrar);
                inpFim.addEventListener('change', filtrar);
                document.getElementById('btn-limpar').addEventListener('click', function () {
                    selTipo.value = '';
                    inpInicio.value = '';
                    inpFim.value = '';
                    filtrar();
                });
                filtrar();
            </script>

            <%- include('../includes/footer') %>