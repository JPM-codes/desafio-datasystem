<%- include('../includes/header') %>
    <%- include('../includes/navbar') %>
        <%- include('../includes/topbar') %>

            <section class="page">
                <div class="page-head">
                    <div>
                        <div class="page-eyebrow">Integração</div>
                        <h1 class="page-title">Documentação da API</h1>
                        <div class="page-subtitle">Endpoints para integração com PDV e outros sistemas</div>
                    </div>
                </div>

                <div class="card section-card mb-3">
                    <div class="stat-grid">
                        <div>
                            <div class="text-muted small mb-1">Base URL</div>
                            <code>http://localhost:3000/api</code>
                        </div>
                        <div>
                            <div class="text-muted small mb-1">Formato</div>
                            <span class="badge-tipo acumulo">JSON</span>
                        </div>
                        <div>
                            <div class="text-muted small mb-1">Autenticação</div>
                            <span class="badge-level bronze">Indisponível</span>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-lg-8">
                        <h5 class="fw-bold mb-3">Clientes</h5>
                        <div class="endpoint"><span class="method get">GET</span> <strong
                                class="ms-2">/clientes</strong>
                            <div class="text-muted small mt-2">Lista todos os clientes cadastrados.</div>
                        </div>
                        <div class="endpoint"><span class="method get">GET</span> <strong
                                class="ms-2">/clientes/busca?nome=&amp;cpf=&amp;documento=</strong>
                            <div class="text-muted small mt-2">Busca clientes por nome, CPF ou tipo de documento.</div>
                        </div>
                        <div class="endpoint"><span class="method get">GET</span> <strong
                                class="ms-2">/clientes/:id</strong>
                            <div class="text-muted small mt-2">Consulta um cliente específico e seus dados.</div>
                        </div>

                        <h5 class="fw-bold my-3">Vendas</h5>
                        <div class="endpoint"><span class="method get">GET</span> <strong
                                class="ms-2">/compras</strong>
                            <div class="text-muted small mt-2">Lista todas as vendas registradas.</div>
                        </div>
                        <div class="endpoint"><span class="method get">GET</span> <strong
                                class="ms-2">/compras/busca?cliente_id=&amp;produto=&amp;data_compra=</strong>
                            <div class="text-muted small mt-2">Busca vendas por cliente, produto ou data.</div>
                        </div>
                        <div class="endpoint"><span class="method get">GET</span> <strong
                                class="ms-2">/compras/:id</strong>
                            <div class="text-muted small mt-2">Consulta uma venda específica.</div>
                        </div>
                        <div class="endpoint"><span class="method post">POST</span> <strong
                                class="ms-2">/compras</strong>
                            <div class="text-muted small mt-2">Registra uma venda e credita os pontos
                                (R$ 1 = 1 ponto, com bônus de nível).</div>
                        </div>

                        <h5 class="fw-bold my-3">Resgates e pontos</h5>
                        <div class="endpoint"><span class="method get">GET</span> <strong
                                class="ms-2">/resgates</strong>
                            <div class="text-muted small mt-2">Lista os resgates realizados.</div>
                        </div>
                        <div class="endpoint"><span class="method post">POST</span> <strong
                                class="ms-2">/resgates</strong>
                            <div class="text-muted small mt-2">Realiza um resgate (100 pontos = R$ 5).</div>
                        </div>
                        <div class="endpoint"><span class="method get">GET</span> <strong
                                class="ms-2">/pontos/saldo/:clienteId</strong>
                            <div class="text-muted small mt-2">Saldo de pontos disponíveis do cliente.</div>
                        </div>
                        <div class="endpoint"><span class="method get">GET</span> <strong
                                class="ms-2">/pontos/historico/:clienteId</strong>
                            <div class="text-muted small mt-2">Histórico de movimentações do cliente.</div>
                        </div>
                        <div class="endpoint"><span class="method get">GET</span> <strong
                                class="ms-2">/pontos/expiracao</strong>
                            <div class="text-muted small mt-2">Pontos que expiram em breve (janela configurável).</div>
                        </div>

                        <h5 class="fw-bold my-3">Impacto (logística reversa + social)</h5>
                        <div class="endpoint"><span class="method get">GET</span> <strong
                                class="ms-2">/impacto</strong>
                            <div class="text-muted small mt-2">Lista as ações, com filtros por tipo, status e
                                ponto de coleta.</div>
                        </div>
                        <div class="endpoint"><span class="method post">POST</span> <strong
                                class="ms-2">/impacto</strong>
                            <div class="text-muted small mt-2">Registra recebimento (doação de calçado ou
                                devolução de caixa) pelo CPF/cliente.</div>
                        </div>
                        <div class="endpoint"><span class="method post">POST</span> <strong
                                class="ms-2">/impacto/:id/validar</strong>
                            <div class="text-muted small mt-2">Inicia a triagem do item (RECEBIDO → EM_TRIAGEM).</div>
                        </div>
                        <div class="endpoint"><span class="method post">POST</span> <strong
                                class="ms-2">/impacto/:id/aprovar</strong>
                            <div class="text-muted small mt-2">Aprova e concede o bônus no saldo
                                (bônus configurável; nunca duplica — 409).</div>
                        </div>
                        <div class="endpoint"><span class="method post">POST</span> <strong
                                class="ms-2">/impacto/:id/recusar</strong>
                            <div class="text-muted small mt-2">Recusa o item (nenhum ponto concedido).</div>
                        </div>
                        <div class="endpoint"><span class="method post">POST</span> <strong
                                class="ms-2">/impacto/:id/destinar</strong>
                            <div class="text-muted small mt-2">Registra a destinação (caixas: reutilização,
                                reciclagem ou outro).</div>
                        </div>
                        <div class="endpoint"><span class="method post">POST</span> <strong
                                class="ms-2">/impacto/:id/entregar</strong>
                            <div class="text-muted small mt-2">Marca o item como entregue.</div>
                        </div>
                        <div class="endpoint"><span class="method get">GET</span> <strong
                                class="ms-2">/impacto/dashboard</strong>
                            <div class="text-muted small mt-2">KPIs da campanha (arrecadados, participantes,
                                evolução, status).</div>
                        </div>
                        <div class="endpoint"><span class="method get">GET</span> <strong
                                class="ms-2">/impacto/ranking</strong>
                            <div class="text-muted small mt-2">Ranking de engajamento (separado do RFM).</div>
                        </div>
                        <div class="endpoint"><span class="method get">GET</span> <strong
                                class="ms-2">/impacto/relatorio</strong>
                            <div class="text-muted small mt-2">Síntese por período e ponto de coleta.</div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card section-card h-100">
                            <h5 class="card-title mb-3"><i class="bi bi-journal-code text-primary"></i>Exemplo de
                                resposta</h5>
                            <div class="code-box">
                                {<br>
                                &nbsp;&nbsp;<span class="code-key">"id"</span>: <span class="code-num">1</span>,<br>
                                &nbsp;&nbsp;<span class="code-key">"cliente_id"</span>: <span
                                    class="code-num">15</span>,<br>
                                &nbsp;&nbsp;<span class="code-key">"produto"</span>: <span
                                    class="code-str">"Tênis Esportivo"</span>,<br>
                                &nbsp;&nbsp;<span class="code-key">"valor_total"</span>: <span
                                    class="code-num">300.00</span>,<br>
                                &nbsp;&nbsp;<span class="code-key">"pontos_total"</span>: <span
                                    class="code-num">600</span><br>
                                }
                            </div>

                            <h5 class="card-title mt-4 mb-3"><i class="bi bi-lightning-charge text-primary"></i>Dica</h5>
                            <div class="alert-card">Todos os endpoints são públicos e retornam dados em formato JSON.
                                Consulte o código em <code>api/</code> para mais detalhes.</div>
                        </div>
                    </div>
                </div>
            </section>

            <%- include('../includes/footer') %>