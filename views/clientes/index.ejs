<%- include('../includes/header') %>
    <%- include('../includes/navbar') %>
        <%- include('../includes/topbar') %>

            <section class="page">
                <div class="page-head">
                    <div>
                        <div class="page-eyebrow">Cadastros</div>
                        <h1 class="page-title">Clientes</h1>
                        <div class="page-subtitle">Gerencie os clientes cadastrados</div>
                    </div>
                    <a href="/clientes/add" class="btn btn-primary"><i class="bi bi-person-plus me-2"></i>Novo cliente</a>
                </div>

                <div class="card section-card">
                    <div class="row g-2 mb-2">
                        <div class="col-lg-6"><div class="position-relative">
                                <i class="bi bi-search position-absolute text-muted" style="left:14px;top:50%;transform:translateY(-50%)"></i>
                                <input class="form-control ps-5" id="busca-cliente" placeholder="Pesquisar por nome, CPF, CNPJ ou ID...">
                            </div></div>
                        <div class="col-lg-3"><select class="form-select" id="ordem-clientes">
                                <option value="az">Ordem A-Z</option>
                                <option value="za">Ordem Z-A</option>
                                <option value="pontos">Maior pontuação</option>
                            </select></div>
                        <div class="col-lg-3 d-flex justify-content-end">
                            <span class="badge-level bronze mb-0 d-flex align-items-center"><i class="bi bi-people me-2"></i><%= clientes.length %> de <%= totalClientes %> clientes</span>
                        </div>
                    </div>

                    <!-- Filtros avançados -->
                    <form method="get" action="/clientes" class="row g-2 mb-2">
                        <div class="col-6 col-md-3 col-xl"><label class="form-label d-block small text-muted mb-1">Status</label>
                            <select class="form-select form-select-sm" name="status">
                                <option value="">Todos</option>
                                <% statusConfig.forEach(function (st) { %>
                                    <option value="<%= st.nome %>" <%= String(filtrosAtivos.status || '').toUpperCase() === st.nome ? 'selected' : '' %>><%= st.nome === 'ATENCAO' ? 'Atenção' : st.nome.charAt(0) + st.nome.slice(1).toLowerCase() %></option>
                                    <% }); %>
                            </select></div>
                        <div class="col-6 col-md-3 col-xl"><label class="form-label d-block small text-muted mb-1">Nível</label>
                            <select class="form-select form-select-sm" name="nivel">
                                <option value="">Todos</option>
                                <% niveisConfig.forEach(function (n) { %>
                                    <option value="<%= n.nome %>" <%= filtrosAtivos.nivel === n.nome ? 'selected' : '' %>><%= n.nome %></option>
                                    <% }); %>
                            </select></div>
                        <div class="col-6 col-md-3 col-xl"><label class="form-label d-block small text-muted mb-1">Numeração</label>
                            <select class="form-select form-select-sm" name="numeracao">
                                <option value="">Todas</option>
                                <% opcoes.numeracoes.forEach(function (n) { %>
                                    <option value="<%= n %>" <%= String(filtrosAtivos.numeracao) === String(n) ? 'selected' : '' %>><%= n %></option>
                                    <% }); %>
                            </select></div>
                        <div class="col-6 col-md-3 col-xl"><label class="form-label d-block small text-muted mb-1">Categoria</label>
                            <select class="form-select form-select-sm" name="categoria">
                                <option value="">Todas</option>
                                <% opcoes.categorias.forEach(function (c) { %>
                                    <option value="<%= c %>" <%= filtrosAtivos.categoria === c ? 'selected' : '' %>><%= c %></option>
                                    <% }); %>
                            </select></div>
                        <div class="col-6 col-md-3 col-xl"><label class="form-label d-block small text-muted mb-1">Estilo</label>
                            <select class="form-select form-select-sm" name="estilo">
                                <option value="">Todos</option>
                                <% opcoes.estilos.forEach(function (e) { %>
                                    <option value="<%= e %>" <%= filtrosAtivos.estilo === e ? 'selected' : '' %>><%= e %></option>
                                    <% }); %>
                            </select></div>
                        <div class="col-6 col-md-3 col-xl"><label class="form-label d-block small text-muted mb-1">Faixa de preço</label>
                            <select class="form-select form-select-sm" name="faixa_preco">
                                <option value="">Todas</option>
                                <option value="Até R$ 90">Até R$ 90</option>
                                <option value="R$ 90 – R$ 150">R$ 90 – R$ 150</option>
                                <option value="R$ 150 – R$ 250">R$ 150 – R$ 250</option>
                                <option value="Acima de R$ 250">Acima de R$ 250</option>
                            </select></div>
                        <div class="col-6 col-md-3 col-xl"><label class="form-label d-block small text-muted mb-1">Mín. dias sem comprar</label>
                            <input type="number" class="form-control form-control-sm" name="min_dias" value="<%= filtrosAtivos.min_dias || '' %>" placeholder="ex.: 60"></div>
                        <div class="col-6 col-md-3 col-xl"><label class="form-label d-block small text-muted mb-1">Mín. compras</label>
                            <input type="number" class="form-control form-control-sm" name="min_compras" value="<%= filtrosAtivos.min_compras || '' %>" placeholder="ex.: 2"></div>
                        <div class="col-6 col-md-3 col-xl"><label class="form-label d-block small text-muted mb-1">Mín. pontos disp.</label>
                            <input type="number" class="form-control form-control-sm" name="min_pontos" value="<%= filtrosAtivos.min_pontos || '' %>" placeholder="ex.: 100"></div>
                        <div class="col-12 d-flex justify-content-end align-items-end gap-2 mt-1">
                            <a href="/clientes" class="btn btn-sm btn-light"><i class="bi bi-x-circle me-1"></i>Limpar</a>
                            <button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-funnel me-1"></i>Filtrar</button>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table" id="tab-clientes">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Cliente</th>
                                    <th>Documento</th>
                                    <th class="text-end">Compras</th>
                                    <th class="text-end">Pontos disp.</th>
                                    <th>Nível</th>
                                    <th>Status</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (clientes.length) { %>
                                    <% clientes.forEach(function (cliente) { %>
                                        <tr>
                                            <td><span class="badge-level silver"><%= cliente.id %></span></td>
                                            <td>
                                                <a href="/clientes/<%= cliente.id %>" class="text-decoration-none text-reset">
                                                    <div class="d-flex align-items-center gap-2"><span class="avatar"><%= cliente.iniciais %></span>
                                                        <div>
                                                            <div class="fw-semibold"><%= cliente.nome %></div>
                                                            <div class="small text-muted"><%= cliente.tipo_documento %> · <%= cliente.cidade || '—' %></div>
                                                        </div>
                                                    </div>
                                                </a>
                                            </td>
                                            <td><%= cliente.documento %></td>
                                            <td class="text-end"><%= cliente.totalCompras %></td>
                                            <td class="fw-bold text-end"><%= cliente.pontosDisponiveis.toLocaleString('pt-BR') %></td>
                                            <td><span class="badge-level <%= cliente.nivel.classe %>"><%= cliente.nivel.nome %></span></td>
                                            <td><span class="badge-status <%= cliente.status.classe %>"><%= cliente.status.nome.toLowerCase() %></span></td>
                                            <td>
                                                <div class="d-flex gap-1">
                                                    <a href="/clientes/<%= cliente.id %>" class="btn btn-sm btn-light btn-action" title="Perfil"><i class="bi bi-eye"></i></a>
                                                    <a href="/clientes/edit/<%= cliente.id %>" class="btn btn-sm btn-light btn-action" title="Editar"><i class="bi bi-pencil"></i></a>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="8" class="text-center text-muted py-4">Nenhum cliente corresponde aos filtros.</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <script>
                const inputBusca = document.getElementById('busca-cliente');
                const selOrdem = document.getElementById('ordem-clientes');
                const tbody = document.querySelector('#tab-clientes tbody');

                function ordenar(alvo, ordem) {
                    const linhas = Array.prototype.slice.call(alvo.querySelectorAll('tr'));
                    linhas.sort(function (a, b) {
                        const get = (tr) => tr.cells[1].textContent.trim();
                        const getPontos = (tr) => Number(tr.cells[4].textContent.replace(/\D/g, ''));
                        const getCompras = (tr) => Number(tr.cells[3].textContent.trim());
                        if (ordem === 'az') return get(a).localeCompare(get(b), 'pt-BR');
                        if (ordem === 'za') return get(b).localeCompare(get(a), 'pt-BR');
                        return getPontos(b) - getPontos(a) || getCompras(b) - getCompras(a);
                    });
                    linhas.forEach((tr) => alvo.appendChild(tr));
                }

                function filtrar() {
                    const termo = inputBusca.value.trim().toLowerCase();
                    tbody.querySelectorAll('tr').forEach(function (tr) {
                        const texto = tr.textContent.toLowerCase();
                        tr.style.display = texto.includes(termo) ? '' : 'none';
                    });
                }

                inputBusca.addEventListener('input', filtrar);
                selOrdem.addEventListener('change', function () {
                    if (tbody.querySelectorAll('tr').length) ordenar(tbody, selOrdem.value);
                });
            </script>

            <%- include('../includes/footer') %>