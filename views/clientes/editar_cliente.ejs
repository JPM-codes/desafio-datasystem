<%- include('../includes/header') %>
    <%- include('../includes/navbar') %>
        <%- include('../includes/topbar') %>

            <section class="page">
                <div class="page-head">
                    <div>
                        <div class="page-eyebrow">Cadastros</div>
                        <h1 class="page-title">Editar cliente</h1>
                        <div class="page-subtitle">Atualize os dados cadastrais de <strong><%= cliente.nome %></strong></div>
                    </div>
                    <a href="/clientes" class="btn btn-light"><i class="bi bi-arrow-left me-2"></i>Voltar</a>
                </div>

                <div class="row justify-content-center">
                    <div class="col-xl-8">
                        <div class="card section-card">
                            <div class="d-flex align-items-center gap-3 mb-4">
                                <span class="avatar avatar-lg bg-gradient"><%= cliente.iniciais %></span>
                                <div>
                                    <div class="fw-bold"><%= cliente.nome %></div>
                                    <div><span class="badge-level <%= cliente.nivel.classe %>"><%= cliente.nivel.nome %></span>
                                        <span class="text-muted small ms-2"><%= cliente.pontos.toLocaleString('pt-BR') %> pontos</span></div>
                                </div>
                            </div>

                            <h5 class="card-title mb-4"><i class="bi bi-pencil-square text-primary"></i>Dados do cliente
                            </h5>
                            <div class="row g-3">
                                <div class="col-md-8"><label class="form-label">Nome completo *</label><input
                                        class="form-control" value="<%= cliente.nome %>"></div>
                                <div class="col-md-4"><label class="form-label">Tipo de documento</label><select
                                        class="form-select">
                                        <option <%= cliente.tipo_documento === 'CPF' ? 'selected' : '' %>>CPF</option>
                                        <option <%= cliente.tipo_documento === 'CNPJ' ? 'selected' : '' %>>CNPJ</option>
                                    </select></div>
                                <div class="col-md-8"><label class="form-label">CPF / CNPJ *</label><input
                                        class="form-control" value="<%= cliente.documento %>"></div>
                                <div class="col-md-4"><label class="form-label">ID interno</label><input
                                        class="form-control" value="<%= cliente.id %>" disabled></div>
                            </div>

                            <div class="alert-card my-3"><i class="bi bi-shield-check me-2"></i>O nível e a pontuação são
                                recalculados automaticamente após cada movimentação.</div>

                            <div class="text-end"><button class="btn btn-primary"><i class="bi bi-check-lg me-2"></i>Salvar
                                    alterações</button></div>
                        </div>
                    </div>
                </div>
            </section>

            <%- include('../includes/footer') %>